{
  "note": "Server list for the Apps section. Each server's urlTemplate builds the frame URL for an app: {url} inserts the target address as-is, and {url_enc} inserts it percent-encoded (Compaxy takes the address as a ?url= query, then redirects into /proxy/). Set \"default\" to the id selected on first load.",
  "default": "us-east-1",
